{
  "name": "toolhome",
  "version": "0.4.0",
  "description": "Self-hosted home for remote-native and home-hosted MCP servers and CLIs.",
  "type": "module",
  "bin": {
    "toolhome": "./dist/server/cli/main.js",
    "mcp-home": "./dist/server/cli/main.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gateway",
    "proxy",
    "oauth",
    "cli",
    "self-hosted"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "prepublishOnly": "npm run build:server",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/server/main.js",
    "cli": "tsx src/cli/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:real": "tsx scripts/real-environment.ts",
    "test:all": "npm run format:check && npm run build && npm run test && npm run test:real",
    "smoke:market": "tsx scripts/smoke-market.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "15.0.0",
    "hono": "4.13.1",
    "jose": "6.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
