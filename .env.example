TOOLHOME_HOST=127.0.0.1
TOOLHOME_PORT=3344
TOOLHOME_PUBLIC_URL=http://127.0.0.1:3344
TOOLHOME_DATA_DIR=./data
TOOLHOME_MASTER_KEY=replace-with-a-random-master-key-of-at-least-32-characters
TOOLHOME_BOOTSTRAP_CONTROL_KEY=tch_ctl_replace-with-a-random-control-key-suffix-of-at-least-32-characters
TOOLHOME_ALLOWED_HOSTS=127.0.0.1,localhost
TOOLHOME_LOG_LEVEL=info
# Optional: PyPI mirror for uv-based Market installs (e.g. a China mirror)
# TOOLHOME_UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Tool call records retention in days (metadata only; 0 disables time-based cleanup)
# TOOLHOME_CALLS_RETENTION_DAYS=30
# How often (seconds) the gateway sweeps stored OAuth credentials for expired
# access tokens and refreshes them automatically via the refresh-token grant.
# TOOLHOME_OAUTH_REFRESH_INTERVAL_SECONDS=300
