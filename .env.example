MCP_HOME_HOST=127.0.0.1
MCP_HOME_PORT=3344
MCP_HOME_PUBLIC_URL=http://127.0.0.1:3344
MCP_HOME_DATA_DIR=./data
MCP_HOME_MASTER_KEY=replace-with-a-random-master-key-of-at-least-32-characters
MCP_HOME_BOOTSTRAP_CONTROL_KEY=tch_ctl_replace-with-a-random-control-key-suffix-of-at-least-32-characters
MCP_HOME_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_HOME_LOG_LEVEL=info
# Optional: PyPI mirror for uv-based Market installs (e.g. a China mirror)
# MCP_HOME_UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# Tool call records retention in days (metadata only; 0 disables time-based cleanup)
# MCP_HOME_CALLS_RETENTION_DAYS=30
# How often (seconds) the gateway sweeps stored OAuth credentials for expired
# access tokens and refreshes them automatically via the refresh-token grant.
# MCP_HOME_OAUTH_REFRESH_INTERVAL_SECONDS=300
